# CodeScapes Environment Configuration
# Copy this file to .env.local and fill in your values

# Supabase Configuration (Required)
# Get these from your Supabase project: https://supabase.com/dashboard
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Server-side Supabase config (Required for Vercel API functions).
# The serverless proxies read SUPABASE_URL/SUPABASE_ANON_KEY and fall back to
# the VITE_ variants. Set these in your Vercel project env for production.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# Scapper AI (Required for the AI assistant)
# Get a key from https://console.groq.com/keys (starts with gsk_).
# Used by the scapper-proxy (dev: vite middleware, prod: Vercel function).
GROQ_API_KEY=gsk_your_key_here

# Bot Protection (Turnstile)
# Get these from Cloudflare Dashboard > Turnstile
VITE_CLOUDFLARE_TURNSTILE_SITE_KEY=your-site-key
CLOUDFLARE_TURNSTILE_SECRET_KEY=your-secret-key

# Rate Limiting (Upstash Redis)
# Get these from Upstash Console > Redis
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-rest-token

# Optional: App Version (auto-populated during build)
VITE_APP_VERSION=0.0.0

# Optional: Sentry DSN for error tracking
# VITE_SENTRY_DSN=https://your-sentry-dsn

# Debug Mode - Set to "true" to enable internal console logs
# In production (Vercel), set to "false" to suppress debug output
VITE_DEBUG=false

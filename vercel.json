{
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    },
    {
      "source": "/sandbox/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/sandbox/sw.js",
      "destination": "/sandbox/sw.js"
    },
    {
      "source": "/sandbox/receiver.js",
      "destination": "/sandbox/receiver.js"
    },
    {
      "source": "/sandbox/bootloader.html",
      "destination": "/sandbox/bootloader.html"
    },
    {
      "source": "/sandbox/run/(.*)",
      "destination": "/sandbox/bootloader.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
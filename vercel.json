{
  "rewrites": [
    {
      "source": "/sandbox/sw.js",
      "destination": "/sandbox/sw.js"
    },
    {
      "source": "/sandbox/receiver.js",
      "destination": "/sandbox/receiver.js"
    },
    {
      "source": "/sandbox/bootloader.html",
      "destination": "/sandbox/bootloader.html"
    },
    {
      "source": "/sandbox/run/(.*)",
      "destination": "/sandbox/bootloader.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}

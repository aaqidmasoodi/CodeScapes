{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self \"https://sandbox.codescapes.io\"), microphone=(self \"https://sandbox.codescapes.io\"), geolocation=()"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Cross-Origin-Embedder-Policy",
          "value": "credentialless"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        }
      ]
    },
    {
      "source": "/sandbox/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        },
        {
          "key": "Pragma",
          "value": "no-cache"
        },
        {
          "key": "Expires",
          "value": "0"
        },
        {
          "key": "Cross-Origin-Resource-Policy",
          "value": "cross-origin"
        }
      ]
    },
    {
      "source": "/sandbox/(.*)",
      "headers": [
        {
          "key": "Cross-Origin-Resource-Policy",
          "value": "cross-origin"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/sandbox/sw.js",
      "destination": "/sandbox/sw.js"
    },
    {
      "source": "/sandbox/receiver.js",
      "destination": "/sandbox/receiver.js"
    },
    {
      "source": "/sandbox/bootloader.html",
      "destination": "/sandbox/bootloader.html"
    },
    {
      "source": "/sandbox/run/(.*)",
      "destination": "/sandbox/bootloader.html"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/robots.txt",
      "destination": "/robots.txt"
    },
    {
      "source": "/assets/(.*)",
      "destination": "/assets/$1"
    },
    {
      "source": "/favicon.svg",
      "destination": "/favicon.svg"
    },
    {
      "source": "/og-image.png",
      "destination": "/og-image.png"
    },
    {
      "source": "/community/scape/:scapeId",
      "destination": "/api/prerender"
    },
    {
      "source": "/community",
      "destination": "/api/prerender"
    },
    {
      "source": "/",
      "destination": "/api/prerender"
    },
    {
      "source": "/api/scapper-proxy",
      "destination": "/api/scapper-proxy"
    },
    {
      "source": "/api/cors-proxy",
      "destination": "/api/cors-proxy"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}